# LSH-RL profile: short-term turn rewards plus qualified long-term trajectory bonus.

export AGL_REWARD_PROFILE=lsh_rl
export AGL_SLIM_LOGS=1

# Keep long-short philosophy, but only qualified turns receive long-term bonus.
export AGL_SHORT_TERM_WEIGHT=0.50
export AGL_LONG_TERM_WEIGHT=0.50
export AGL_LONG_TERM_GATE_BAD_TURNS=1
export AGL_LONG_TERM_BONUS_MIN_SHORT=0.45

# Keep PPO focused on interaction turns.
export AGL_ALLOWED_TRACE_TYPES=action,dialogue

# Training defaults.
export AGL_TOTAL_EPOCHS=1
export AGL_TRAIN_BATCH_SIZE=2
export AGL_ROLLOUT_GPU_MEMORY_UTIL=0.35
export AGL_TEST_FREQ=0
export AGL_SAVE_FREQ=4
export AGL_MAX_PROMPT_LENGTH=3000
export AGL_MAX_RESPONSE_LENGTH=256

# Lightweight continuation, no full actor/critic shard restore.
export AGL_CHECKPOINT_POLICY=inference
export AGL_MAX_CKPT_TO_KEEP=1
# export AGL_NO_RESUME=1
export AGL_SAVE_BEST_ONLY=0
export AGL_BEST_CKPT_METRIC=val/reward

# Keep the policy closer to DPO while the reward shape is still being corrected.
export AGL_ACTOR_USE_KL_LOSS=true
export AGL_ACTOR_KL_LOSS_COEF=0.05
export AGL_ACTOR_ENTROPY_COEFF=0.001

export AGL_TRAIN_LOGGERS=console,tensorboard

# VERL configuration
export HYDRA_FULL_ERROR=1
