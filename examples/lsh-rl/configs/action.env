# LSH-RL action phase with the same RL runtime shape as dialogue.

# shellcheck disable=SC1091
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/base.env"

export AGL_EXPERIMENT_NAME="${AGL_EXPERIMENT_NAME:-action-RL}"

# Start action RL from the dialogue-phase adapter.
export AGL_BASE_MODEL="${AGL_BASE_MODEL:-xxx}"
export AGL_ADAPTER_PATH="${AGL_ACTION_INIT_ADAPTER_PATH:-${AGL_ADAPTER_PATH:-xxx}}"
export ROLEPLAY_ENV_BASE_URL="${ROLEPLAY_ENV_BASE_URL:-xxx}"
export ROLEPLAY_ENV_API_KEY="${ROLEPLAY_ENV_API_KEY:-xxx}"
export ROLEPLAY_ENV_MODEL="${ROLEPLAY_ENV_MODEL:-xxx}"
export AGL_VERIFIER_BASE_URL="${AGL_VERIFIER_BASE_URL:-$ROLEPLAY_ENV_BASE_URL}"
export AGL_VERIFIER_API_KEY="${AGL_VERIFIER_API_KEY:-$ROLEPLAY_ENV_API_KEY}"
export AGL_VERIFIER_MODEL="${AGL_VERIFIER_MODEL:-$ROLEPLAY_ENV_MODEL}"

# Keep initialization fixed to the supplied dialogue adapter unless the caller overrides it.
export AGL_RESUME_STRATEGY=lightweight
export AGL_NO_RESUME="${AGL_NO_RESUME:-1}"
export AGL_SLIM_LOGS=1

export AGL_ROLEPLAY_TRAIN_PHASE=action_only
export AGL_ALLOWED_TRACE_TYPES=action
export AGL_TEST_FREQ=0

# Same four-card setup as dialogue.
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3}"
export AGL_N_GPUS_PER_NODE=4
export AGL_N_RUNNERS=4
export AGL_SPLIT_ACTOR_CRITIC_GPUS=0

# Same 2:1:1 stratified sampling as dialogue.
export AGL_TRAIN_BATCH_SIZE=4
export AGL_STRATIFIED_TRAINING=1
export AGL_TRAIN_DATA_DIR="train_data"
export AGL_NUM_BATCHES=200
export AGL_LOW_RATIO=2
export AGL_MEDIUM_RATIO=1
export AGL_HIGH_RATIO=1
